    rdfs:label "experimentieren: Nachweis von Glucose und Proteinen in Nahrungsmitteln"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
    lp:LP_0000812 <https://w3id.org/schulart/TH_0000006> ;
    lp:LP_0000029 <https://w3id.org/lehrplan/ontology/LP_3000031> ;
    evomentor:sourceId "GY-78-HUM-FPA-1" ;
    lp:LP_0000026 <https://w3id.org/lehrplan/ontology/LP_2000007> ;
    evomentor:basiskonzeptPrimaer "kmk-basiskonzepte-biologie:bk_stoff_energie_umwandlung" ;
    evomentor:buildsOn thsh:lz-gy78-gy-78-hum-vd-1 ;
    evomentor:buildsToward thsh:lz-gy78-gy-78-hum-vd-2 ;
    evomentor:evolutionsrelevanz 1 ;
    evomentor:wissenschaftlicheBegruendung "Der biochemische Nachweis von Nährstoffen ist eine praktische Anwendung des Wissens über die molekulare Zusammensetzung von Lebensmitteln, die evolutionär entstanden sind. Glukose ist das universelle Energiemolekül aller lebenden Organismen, Proteine sind die wichtigsten Funktionsmoleküle. Die biochemische Universalität dieser Moleküle ist selbst ein Beleg für die gemeinsame evolutionäre Herkunft aller Lebewesen."@de ;
    evomentor:relevantesEvolutionskonzept "gemeinsame Abstammung/Verwandtschaft" ;
    evomentor:relevantesEvolutionskonzept "Konservierung von Merkmalen (gemeinsame genetische Grundlagen, Baupläne, Entwicklungsprozesse usw.)" .
thsh:lz-gy78-gy-78-hum-fpa-2 a thsh:Kompetenzerwartung_TH ;
    rdfs:label "experimentieren: Nachweis der enzymatischen Spaltung von Stärke"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
    lp:LP_0000812 <https://w3id.org/schulart/TH_0000006> ;
    lp:LP_0000029 <https://w3id.org/lehrplan/ontology/LP_3000031> ;
    evomentor:sourceId "GY-78-HUM-FPA-2" ;
