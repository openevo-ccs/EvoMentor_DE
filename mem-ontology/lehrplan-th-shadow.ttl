    rdfs:label "die Bedeutung von Bakterien erläutern (z. B. in der Lebensmittelherstellung, als Krankheitserreger, als Zersetzer)"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
    lp:LP_0000812 <https://w3id.org/schulart/TH_0000006> ;
