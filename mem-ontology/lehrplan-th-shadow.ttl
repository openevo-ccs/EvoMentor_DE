thsh:lz-gy78-gy-78-hum-ner-6 a thsh:Kompetenzerwartung_TH ;
    rdfs:label "die Reiz-Reaktions-Kette beschreiben: Informationsweiterleitung über motorische Nerven"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
    lp:LP_0000812 <https://w3id.org/schulart/TH_0000006> ;
    lp:LP_0000029 <https://w3id.org/lehrplan/ontology/LP_3000031> ;
    evomentor:sourceId "GY-78-HUM-NER-6" ;
    lp:LP_0000026 <https://w3id.org/lehrplan/ontology/LP_2000008> ;
    evomentor:basiskonzeptPrimaer "kmk-basiskonzepte-biologie:bk_information_kommunikation" ;
    evomentor:buildsOn thsh:lz-gy78-gy-78-hum-ner-5 ;
    evomentor:buildsToward thsh:lz-gy78-gy-78-hum-ner-7 ;
    evomentor:evolutionsrelevanz 2 ;
    evomentor:wissenschaftlicheBegruendung "Die motorische Innervation von Muskeln durch Motoneurone ist ein evolutionär konserviertes Prinzip, das bei allen Bilateria vorkommt und auf einen gemeinsamen bilateralsymmetrischen Vorfahren hindeutet. Die neuromuskuläre Synapse nutzt Acetylcholin als Neurotransmitter, ein Molekül, das evolutionär extrem konserviert ist und bei Tieren von Nematoden bis zum Menschen vorkommt. Dies ist ein eindrückliches Beispiel für molekulare Homologie als Beleg für gemeinsame Abstammung. Die evolutionäre Spezialisierung motorischer Systeme (z. B. Feinmotorik des menschlichen Daumens) zeigt, wie Selektion auf präzise Bewegungskoordination wirken kann."@de ;
    evomentor:relevantesEvolutionskonzept "Konservierung von Merkmalen (gemeinsame genetische Grundlagen, Baupläne, Entwicklungsprozesse usw.)" ;
    evomentor:relevantesEvolutionskonzept "gemeinsame Abstammung/Verwandtschaft" ;
    evomentor:relevantesEvolutionskonzept "Anpassung und Angepasstheit" ;
    evomentor:relevantesEvolutionskonzept "Natürliche Selektion und Selektionsdruck" .
thsh:lz-gy78-gy-78-hum-ner-7 a thsh:Kompetenzerwartung_TH ;
    rdfs:label "die Reiz-Reaktions-Kette beschreiben: Reaktion am Effektor (z. B. Muskel)"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
    lp:LP_0000812 <https://w3id.org/schulart/TH_0000006> ;
    lp:LP_0000029 <https://w3id.org/lehrplan/ontology/LP_3000031> ;
