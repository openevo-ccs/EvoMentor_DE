    rdfs:label "Bakterien, Hefepilze und Viren als Krankheitserreger kennzeichnen: Beispiele für Erreger und dadurch ausgelöste Krankheiten"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
