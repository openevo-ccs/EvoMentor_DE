    lp:LP_0000026 <https://w3id.org/lehrplan/ontology/LP_2000007> ;
    evomentor:basiskonzeptPrimaer "kmk-basiskonzepte-biologie:bk_struktur_funktion" ;
    evomentor:basiskonzeptSekundaer "kmk-basiskonzepte-biologie:bk_evolutive_entwicklung" ;
    evomentor:buildsOn thsh:lz-gy78-gy-78-wir-wtg-2 ;
    evomentor:buildsOn thsh:lz-gy78-gy-78-wir-wtg-3 ;
    evomentor:buildsOn thsh:lz-gy78-gy-78-wir-wtg-4 ;
    evomentor:buildsToward thsh:lz-gy78-gy-78-wir-wtg-7 ;
    evomentor:evolutionsrelevanz 3 ;
    evomentor:wissenschaftlicheBegruendung "Die begründete Zuordnung von Vertretern zu Tiergruppen ist eine grundlegende taxonomische Kompetenz, die direkt auf das evolutionsbiologische Konzept der natürlichen Klassifikation verweist. In der modernen Biologie gilt: Klassifikationen sind nur dann biologisch sinnvoll, wenn sie phylogenetische Abstammungsgemeinschaften (monophyletische Gruppen) widerspiegeln. Wenn Schüler ein Tier anhand von Merkmalen einer Gruppe zuordnen, wenden sie implizit das Konzept der Synapomorphien an. Das Missklassifizieren kann genutzt werden, um zu diskutieren, warum äußerliche Ähnlichkeit kein verlässliches Verwandtschaftskriterium ist. Die Einordnung von Tieren in einen Stammbaum und die Interpretation von Verwandtschaftsverhältnissen anhand gemeinsamer Merkmale ist das Kerngeschäft phylogenetischen Denkens."@de ;
    evomentor:relevantesEvolutionskonzept "Stammbäume und phylogenetische Systematik" ;
    evomentor:relevantesEvolutionskonzept "gemeinsame Abstammung/Verwandtschaft" ;
    evomentor:relevantesEvolutionskonzept "Homologie und Analogie/Konvergente und divergente Evolution" ;
    evomentor:relevantesEvolutionskonzept "Konservierung von Merkmalen (gemeinsame genetische Grundlagen, Baupläne, Entwicklungsprozesse usw.)" .
thsh:lz-gy78-gy-78-wir-wtg-6 a thsh:Kompetenzerwartung_TH ;
    rdfs:label "die Bedeutung Wirbelloser in der Natur (z. B. als Glieder von Nahrungsketten, Bestäuber, Krankheitsüberträger) an Beispielen erläutern"@de ;
    lp:LP_0000537 <https://w3id.org/schulfach/TH_0000002> ;
