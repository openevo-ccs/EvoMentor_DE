    evomentor:relevantesEvolutionskonzept "Natürliche Selektion und Selektionsdruck" ;
    evomentor:relevantesEvolutionskonzept "geologische Epochen" .
thsh:lz-gy78-gy-78-wir-ins-4 a thsh:Kompetenzerwartung_TH ;
    rdfs:label "wesentliche Merkmale beschreiben: Nervensystem (Strickleiternervensystem)"@de ;
